# Copy this to .env and fill it in:   cp .env.example .env
#
# docker compose reads .env automatically. If you run the server directly with
# `npm start`, export these yourself (or use `node --env-file=.env server.js`,
# Node 20.6+).
#
# Every value here is optional — the defaults are shown.

# The admin console's password. Leave it unset and the console is open to anyone
# who can reach it. Put something here before putting this on the internet.
ADMIN_PASSWORD=

# The port the server listens on.
PORT=3005

# Where your library is. These paths are inside the container, so anything you
# point them at needs a matching volume mount in docker-compose.yml — the
# defaults mount ./media as /app/media.
# CONTENT_DIR=/app/media
# MOVIES_DIR=/app/media/Movies

# How long ffprobe gets to measure a file before giving up, in milliseconds.
# Raise it if your files are on a slow mount; lower it if a broken file makes
# the build crawl.
PROBE_TIMEOUT=30000

# How long a failed conversion is left alone before it is tried again, in
# milliseconds. A file that is still downloading reads as broken, so this is
# how long the app waits before deciding it really is broken.
TC_BAD_RETRY_MS=3600000
